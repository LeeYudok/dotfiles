# ~/.zshrc — Linux 서버용 미니멀 구성. 저장소 dotfiles/zsh/zshrc.linux 가 원본.
# 구조는 zshrc.macos 와 동일하되, 서버엔 없을 수 있는 도구(starship/eza/zoxide/fzf)는 있을 때만 켠다.

# ── 환경 / PATH ────────────────────────────────────────────
typeset -U path PATH
[ -d "$HOME/bin" ] && path=("$HOME/bin" $path)
[ -d "$HOME/.local/bin" ] && path=("$HOME/.local/bin" $path)
export EDITOR=vim

# ── 히스토리 / 셸 옵션 ─────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP

# ── 자동완성 ───────────────────────────────────────────────
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# ── 프롬프트 — starship (없으면 기본 프롬프트로 폴백) ────────
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
else
  autoload -Uz colors && colors
  PROMPT='%F{green}%n@%m%f %F{blue}%~%f %# '
fi

# ── 있을 때만 켜는 도구 ─────────────────────────────────────
if command -v zoxide >/dev/null; then
  export _ZO_DOCTOR=0
  eval "$(zoxide init zsh --cmd cd)"
fi
if command -v fzf >/dev/null; then
  source <(fzf --zsh) 2>/dev/null || true   # fzf < 0.48 은 --zsh 미지원
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"
fi

# ── alias ──────────────────────────────────────────────────
if command -v eza >/dev/null; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -l --icons --git --sort=modified"
  alias la="eza -la --icons --git --group-directories-first"
else
  alias ls='ls --color=auto'
  alias ll='ls -alF'
  alias la='ls -A'
fi
alias grep='grep --color=auto'

# ── 시크릿 (mode 600, 버전관리 제외) ────────────────────────
[ -f "$HOME/.secrets.zsh" ] && source "$HOME/.secrets.zsh"

# ── 머신별 alias/함수 (미추적, 템플릿: zsh/zshrc.local.example) ──
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ── 플러그인 (syntax-highlighting 은 맨 마지막) ─────────────
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
